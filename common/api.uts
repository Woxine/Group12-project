/**
 * 后端 API 根地址 —— 根据 debug/release 自动切换
 *
 * debug  包（HBuilderX "运行"）→ http://localhost:8080
 * release 包（HBuilderX "发行"）→ http://8.137.174.238:8080
 *
 * 本地调试时用 USB + adb reverse tcp:8080 tcp:8080 即可连通后端
 */
import { UTSAndroid } from 'io.dcloud.uts'

const DEBUG_URL = 'http://localhost:8080'
const RELEASE_URL = 'http://8.137.174.238:8080'

function isDebugBuild(): boolean {
	const context = UTSAndroid.getAppContext()
	if (context == null) return false
	return (context.applicationInfo.flags & 0x2 /* ApplicationInfo.FLAG_DEBUGGABLE */) != 0
}

export const BASE_URL = isDebugBuild() ? DEBUG_URL : RELEASE_URL

// ID9 guest booking
export const GUEST_BOOKING_CREATE_URL = '/api/v1/bookings/guest'
export const SCOOTER_LIST_URL = '/api/v1/scooters'
export const USER_BOOKINGS_TEMPLATE_URL = '/api/v1/users/{userId}/bookings'
export const SALESPERSON_BIND_GUEST_CARD_TEMPLATE_URL = '/api/v1/users/{salespersonId}/payment-cards/guest/{guestId}'
