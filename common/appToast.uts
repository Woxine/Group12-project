/**
 * Unified Toast Notification Module — native uni.showToast
 */

const LONG_TEXT_THRESHOLD = 50

export function showSuccess(title: string, duration: number = 2500) {
	uni.showToast({
		title: title,
		icon: 'success',
		duration: duration
	})
}

export function showError(title: string, duration: number = 4000) {
	if (title.length > LONG_TEXT_THRESHOLD) {
		uni.showModal({
			title: 'Notice',
			content: title,
			showCancel: false,
			confirmText: 'OK'
		})
	} else {
		uni.showToast({
			title: title,
			icon: 'none',
			duration: duration
		})
	}
}

export function showInfo(title: string, duration: number = 2800) {
	if (title.length > LONG_TEXT_THRESHOLD) {
		uni.showModal({
			title: 'Notice',
			content: title,
			showCancel: false,
			confirmText: 'OK'
		})
	} else {
		uni.showToast({
			title: title,
			icon: 'none',
			duration: duration
		})
	}
}

export function showThenNavigate(
	title: string,
	url: string,
	isSuccess: boolean = true,
	delayMs: number = 2500,
	navigateType: string = 'navigateTo'
) {
	if (isSuccess) {
		uni.showToast({
			title: title,
			icon: 'success',
			duration: delayMs
		})
	} else {
		uni.showToast({
			title: title,
			icon: 'none',
			duration: delayMs
		})
	}

	setTimeout(() => {
		if (navigateType == 'navigateBack') {
			uni.navigateBack({})
		} else if (navigateType == 'redirectTo') {
			uni.redirectTo({ url: url })
		} else if (navigateType == 'reLaunch') {
			uni.reLaunch({ url: url })
		} else {
			uni.navigateTo({ url: url })
		}
	}, delayMs)
}

export function showConfirm(title: string, content: string, confirmText: string = 'Confirm', cancelText: string = 'Cancel'): Promise<boolean> {
	return new Promise<boolean>((resolve) => {
		uni.showModal({
			title: title,
			content: content,
			confirmText: confirmText,
			cancelText: cancelText,
			success: (res) => {
				resolve(res.confirm)
			}
		})
	})
}

export function showActionSheet(items: string[]): Promise<number> {
	return new Promise<number>((resolve) => {
		uni.showActionSheet({
			itemList: items,
			success: (res) => {
				resolve(res.tapIndex)
			},
			fail: () => {
				resolve(-1)
			}
		})
	})
}
