<template>
	<view class="container">
		<view class="title-section">
			<text class="title">Discount Verification</text>
			<text class="hint">Student verification is required for student discount. Senior verification is optional.</text>
		</view>

		<view class="type-card">
			<view class="type-tabs">
				<view :class="['type-tab', typeIndex == 0 ? 'type-tab-active' : '']" @click="selectType(0)">
					<text :class="['type-tab-text', typeIndex == 0 ? 'type-tab-text-active' : '']">Student</text>
				</view>
				<view :class="['type-tab', typeIndex == 1 ? 'type-tab-active' : '']" @click="selectType(1)">
					<text :class="['type-tab-text', typeIndex == 1 ? 'type-tab-text-active' : '']">Senior</text>
				</view>
			</view>
			<view class="type-body">
				<text class="label">Verification Image</text>
				<view v-if="selectedFilePath.length > 0" class="image-preview">
					<image :src="selectedFilePath" mode="aspectFit" class="preview-img"></image>
					<view class="image-info">
						<text class="file-name">{{ selectedFileName }}</text>
						<text class="change-link" @click="chooseImageFile">Change</text>
					</view>
				</view>
				<view v-else class="upload-area" @click="chooseImageFile">
					<text class="upload-icon">+</text>
					<text class="upload-text">Tap to upload image</text>
				</view>
				<button class="btn primary" :disabled="isSubmitting" @click="submitVerification">
					{{ isSubmitting ? 'Submitting...' : 'Submit Verification' }}
				</button>
			</view>
		</view>

		<view class="card">
			<view class="status-header">
				<text class="label">My Submission Status</text>
				<button class="mini-btn" :disabled="isLoading" @click="loadSubmissions">Refresh</button>
			</view>
			<text v-if="isLoading" class="status-text">Loading...</text>
			<view v-else-if="submissions.length > 0">
				<view v-for="item in submissions" :key="item.id" class="status-item">
					<view class="status-top-row">
						<text class="type-badge">{{ getTypeLabel(item.type) }}</text>
						<text :class="['status-badge', getStatusClass(item.status)]">{{ getStatusLabel(item.status) }}</text>
					</view>
					<text class="status-sub">Submitted: {{ formatSubmittedAt(item.submittedAt) }}</text>
					<text v-if="item.rejectReason.length > 0" class="reject-reason">Reason: {{ item.rejectReason }}</text>
				</view>
			</view>
			<text v-else class="status-text">No submissions yet</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { BASE_URL } from '../../common/api.uts'
import { getAppMessage, getResponseMessage } from '../../common/messages.uts'
import { showError, showInfo, showSuccess } from '../../common/appToast.uts'

type SubmissionItem = {
	id: number
	type: string
	status: string
	submittedAt: string
	rejectReason: string
}

const typeOptions = ['STUDENT', 'SENIOR']
const typeIndex = ref(0)
const isSubmitting = ref(false)
const isLoading = ref(false)
const selectedFilePath = ref('')
const selectedFileName = ref('')
const submissions = ref<SubmissionItem[]>([])

const readStorageStringOrNull = (key: string): string | null => {
	const raw = uni.getStorageSync(key)
	if (raw == null) return null
	const value = ('' + raw).trim()
	return value.length < 1 ? null : value
}

const normalizeStatus = (status: string): string => {
	return status == null ? '' : status.trim().toUpperCase()
}

const getStatusLabel = (status: string): string => {
	const normalized = normalizeStatus(status)
	if (normalized == 'APPROVED') return 'Approved'
	if (normalized == 'REJECTED') return 'Rejected'
	if (normalized == 'PENDING') return 'Pending Review'
	return normalized.length > 0 ? normalized : 'Unknown'
}

const getStatusClass = (status: string): string => {
	const normalized = normalizeStatus(status)
	if (normalized == 'APPROVED') return 'status-approved'
	if (normalized == 'REJECTED') return 'status-rejected'
	if (normalized == 'PENDING') return 'status-pending'
	return 'status-unknown'
}

const getTypeLabel = (type: string): string => {
	const normalized = type == null ? '' : type.trim().toUpperCase()
	if (normalized == 'STUDENT') return 'Student'
	if (normalized == 'SENIOR') return 'Senior'
	return normalized.length > 0 ? normalized : 'Unknown Type'
}

const getAuth = (): UTSJSONObject | null => {
	const userId = readStorageStringOrNull('userId')
	const token = readStorageStringOrNull('token')
	if (userId == null || token == null) {
		showInfo(getAppMessage('auth', 'loginRequired', 'Please login first'))
		return null
	}
	const auth = {} as UTSJSONObject
	auth['userId'] = userId
	auth['token'] = token
	return auth
}

const selectType = (index: number) => {
	typeIndex.value = index
}

const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']

const formatSubmittedAt = (raw: string): string => {
	if (raw.length < 10) return raw
	const datePart = raw.substring(0, 10)
	const parts = datePart.split('-')
	if (parts.length < 3) return raw
	const year = parseInt(parts[0])
	const month = parseInt(parts[1])
	const day = parseInt(parts[2])
	let timeStr = ''
	if (raw.length >= 16 && (raw.substring(10, 11) == 'T' || raw.substring(10, 11) == ' ')) {
		timeStr = raw.substring(11, 16)
	}
	const result = day + ' ' + monthNames[month - 1] + ' ' + year
	return timeStr.length > 0 ? result + ', ' + timeStr : result
}

const chooseImageFile = () => {
	uni.chooseImage({
		count: 1,
		sourceType: ['album', 'camera'],
		success: (res) => {
			if (res.tempFilePaths.length > 0) {
				selectedFilePath.value = res.tempFilePaths[0]
				const path = selectedFilePath.value
				const slashIndex = path.lastIndexOf('/')
				selectedFileName.value = slashIndex >= 0 ? path.substring(slashIndex + 1) : path
			}
		}
	})
}

const loadSubmissions = () => {
	const auth = getAuth()
	if (auth == null) return
	const userId = '' + auth['userId']
	const token = '' + auth['token']
	isLoading.value = true
	uni.request({
		url: BASE_URL + '/api/v1/users/' + userId + '/discount-verifications?page=1&size=20',
		method: 'GET',
		header: {
			'Content-Type': 'application/json',
			'Authorization': 'Bearer ' + token
		},
		success: (res) => {
			if (res.statusCode >= 200 && res.statusCode < 300) {
				const payload = res.data as UTSJSONObject
				const dataField = payload['data']
				const result: SubmissionItem[] = []
				if (dataField != null && Array.isArray(dataField)) {
					const arr = dataField as UTSJSONObject[]
					for (let i = 0; i < arr.length; i++) {
						const item = arr[i]
						result.push({
							id: item['id'] != null ? parseInt('' + item['id']) : 0,
							type: item['type'] != null ? ('' + item['type']) : '',
							status: item['status'] != null ? ('' + item['status']) : '',
							submittedAt: item['submittedAt'] != null ? ('' + item['submittedAt']) : '',
							rejectReason: item['rejectReason'] != null ? ('' + item['rejectReason']) : ''
						})
					}
				}
				submissions.value = result
			} else {
				const msg = getResponseMessage(res.data, 'Failed to load submissions')
				showError(msg)
			}
		},
		fail: () => {
			showError(getAppMessage('network', 'requestFailed', 'Network error'))
		},
		complete: () => {
			isLoading.value = false
		}
	})
}

const submitVerification = () => {
	if (isSubmitting.value) return
	const auth = getAuth()
	if (auth == null) return
	if (selectedFilePath.value.length < 1) {
		showInfo('Please choose an image file first')
		return
	}

	const userId = '' + auth['userId']
	const token = '' + auth['token']
	const typeValue = typeOptions[typeIndex.value]
	isSubmitting.value = true

	uni.uploadFile({
		url: BASE_URL + '/api/v1/users/' + userId + '/discount-verifications',
		filePath: selectedFilePath.value,
		name: 'file',
		formData: {
			'type': typeValue
		},
		header: {
			'Authorization': 'Bearer ' + token
		},
		success: (res) => {
			if (res.statusCode >= 200 && res.statusCode < 300) {
				showSuccess('Verification submitted')
				selectedFilePath.value = ''
				selectedFileName.value = ''
				loadSubmissions()
			} else {
				let msg = 'Failed to submit verification'
				if (res.data != null && ('' + res.data).length > 0) {
					try {
						const parsed = JSON.parse<UTSJSONObject>('' + res.data)!!
						msg = getResponseMessage(parsed, msg)
					} catch (e) {
						// ignore parse failure and keep fallback message
					}
				}
				showError(msg)
			}
		},
		fail: () => {
			showError(getAppMessage('network', 'requestFailed', 'Network error'))
		},
		complete: () => {
			isSubmitting.value = false
		}
	})
}

onMounted(() => {
	loadSubmissions()
})

onShow(() => {
	loadSubmissions()
})
</script>

<style lang="scss">
