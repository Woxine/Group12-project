	font-size: 15px;
	font-weight: bold;
	color: $text-primary;
	margin-bottom: 6px;
}

.type-card {
	background-color: $bg-card;
	border-radius: 12px;
	margin-bottom: 14px;
	box-shadow: $shadow-card;
	overflow: hidden;
}

.type-tabs {
	display: flex;
	flex-direction: row;
}

.type-tab {
	flex: 1;
	padding: 10px 12px;
	display: flex;
	justify-content: center;
	align-items: center;
	background-color: #f0f0f0;
	border-bottom-width: 2px;
	border-bottom-style: solid;
	border-bottom-color: transparent;
}

.type-tab-active {
	background-color: $bg-card;
	border-bottom-color: $brand-green;
}

.type-tab-text {
	font-size: 16px;
	font-weight: bold;
	color: $text-secondary;
}

.type-tab-text-active {
	color: $brand-green;
}

