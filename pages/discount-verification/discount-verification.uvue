	padding: 14px 16px;
}

.upload-area {
	border: 2px dashed $border-base;
	border-radius: 12px;
	padding: 24px;
	margin-bottom: 12px;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	background-color: #fafafa;
}

.upload-icon {
	font-size: 32px;
	color: $text-placeholder;
	margin-bottom: 6px;
}

.upload-text {
	font-size: $font-caption;
	color: $text-placeholder;
}

.image-preview {
	margin-bottom: 12px;
	border-radius: 10px;
	overflow: hidden;
	border: 1px solid $border-base;
}

.preview-img {
	width: 100%;
	height: 200px;
}

.image-info {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 8px 12px;
	background-color: #fafafa;
}

.file-name {
	font-size: $font-caption;
	color: $text-secondary;
	flex: 1;
}

.change-link {
	font-size: $font-caption;
	color: $brand-green;
	font-weight: bold;
}

.btn {
	margin-top: 8px;
	padding: 10px 24px;
	border-radius: 8px;
	font-size: 15px;
	width: auto;
	align-self: center;
}

.primary {
	background-color: $brand-green;
	color: $text-inverse;
}

.secondary {
	background-color: $bg-card;
	color: $brand-green;
	border: 1px solid $brand-green;
}

.status-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 8px;
}

.mini-btn {
	font-size: $font-hint;
	padding: 6px 10px;
	background-color: #f0f7ff;
	color: #2f7fe6;
	border-radius: 6px;
}

.status-text {
	font-size: $font-caption;
	color: #888;
}

.status-item {
	padding: 14px 12px;
	border-top: 1px solid #f0f0f0;
	border-radius: 12px;
	background-color: #f8fbff;
	border-left: 4px solid #cbd5e1;
	margin-top: 10px;
}

.status-item:first-child {
	border-top-width: 0;
	margin-top: 0;
}

.status-top-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 8px;
}

.type-badge {
	font-size: $font-hint;
	font-weight: bold;
	color: $color-info;
	background-color: #dbeafe;
	padding: 5px 10px;
	border-radius: 999px;
}

.status-badge {
	font-size: $font-hint;
	font-weight: bold;
	padding: 5px 10px;
	border-radius: 999px;
}

.status-pending {
	color: $color-warning;
	background-color: #fef3c7;
}

.status-approved {
	color: $brand-green;
	background-color: $brand-green-bg;
}

.status-rejected {
	color: $color-danger;
	background-color: #fee2e2;
}

.status-unknown {
	color: $text-primary;
	background-color: #e5e7eb;
}

.status-sub {
	font-size: $font-hint;
	color: $text-secondary;
	margin-bottom: 2px;
}

