<template>
	<view class="page-container">
		<!-- 1. 全局沉浸式地图 -->
		<map id="mainMap" class="full-map" :longitude="longitude" :latitude="latitude" :scale="scale" :markers="markers" show-location @regionchange="onMapRegionChange"></map>

		<!-- 2. 顶部悬浮栏：有活跃订单时显示订单概览，否则显示公告 -->
		<view v-if="activeBooking != null" class="order-overview-pill" @click="goToOrders">
			<view :class="['order-accent-bar', activeBooking.status == 'CONFIRMED' ? 'accent-confirmed' : 'accent-awaiting']"></view>
			<view class="order-content">
				<view class="order-main-row">
					<text :class="['order-status-label', activeBooking.status == 'CONFIRMED' ? 'label-confirmed' : 'label-awaiting']">{{ activeBooking.status == 'CONFIRMED' ? 'Riding' : 'Awaiting Payment' }}</text>
					<text class="order-detail-text">{{ activeBooking.status == 'CONFIRMED' ? elapsedText : formatScooterId(activeBooking.scooterId) }}</text>
				</view>
			</view>
			<text class="order-chevron">></text>
		</view>
		<view v-else class="top-notice-pill">
			<image src="/static/icons/broadcast.png" mode="aspectFit" class="notice-icon"></image>
			<swiper class="notice-swiper" vertical="true" autoplay="true" circular :interval="3000" :duration="1000">
				<swiper-item><text class="notice-text">Before cycling, check the brakes, seat, and pedals.</text></swiper-item>
				<swiper-item><text class="notice-text">Remember to return the e-Scooter when the ride is over.</text></swiper-item>
			</swiper>
		</view>

		<!-- 3. 底部操作卡片 -->
		<view class="bottom-action-card">
			<view class="card-header">
				<text class="card-title">We offer you a variety of options.</text>
				<text class="link-text" @click="showVehicleIntro">View Details ></text>
			</view>
			
			<!-- 
			<swiper class="modern-swiper" :indicator-dots="true" :autoplay="true" :interval="3000" :duration="1000"
			indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#4CAF50" circular>
				<swiper-item><image src="/static/vehicles/gen1_escooter_Fz3_liangziyin.png" mode="aspectFill" class="card-img"></image></swiper-item>
				<swiper-item><image src="/static/vehicles/gen2_eScooter_V70_GardeniaGreen_005.png" mode="aspectFill" class="card-img"></image></swiper-item>
				<swiper-item><image src="/static/vehicles/gen3_eScooter-M95C_MK2-jingyahui.png" mode="aspectFill" class="card-img"></image></swiper-item>
				<swiper-item><image src="/static/vehicles/gen3_pro_Escooter_E300PMK2_QuantumSilver_PC.png" mode="aspectFill" class="card-img"></image></swiper-item>
			</swiper>
			-->
			
			<view class="booking-button" @click="goToBikeList">
				<text class="btn-text">Book a Ride</text>
				<text class="btn-arrow">→</text>
			</view>
		</view>

		<!-- 4. 车辆介绍全屏悬浮卡片 -->
		<VehicleIntroOverlay :visible="isVehicleIntroVisible" @close="hideVehicleIntro" />
	</view>

	<TabBar current="home" />
</template>


<script setup lang="uts">
	// 首页逻辑：获取定位、加载滑板车地图标记、定时刷新、跳转滑板车列表
	import { ref, onMounted, getCurrentInstance, nextTick } from 'vue'
	import { onShow, onHide } from '@dcloudio/uni-app'
	import { BASE_URL } from '../../common/api.uts'
	import { getAppMessage } from '../../common/messages.uts'
	import { showSuccess, showError, showInfo, showThenNavigate } from '../../common/appToast.uts'

	const longitude = ref(116.392325)
	const latitude = ref(40.01811)
	const scale = ref(16)
	const markers = ref([] as Marker[])
	const mapContext = ref(null as MapContext | null)
	const FILTER_RADIUS_METERS = 3000
	const MARKER_LIMIT = 50
	let regionDebounceTimer: number | null = null

	const isVehicleIntroVisible = ref(false)

	type ActiveBookingInfo = {
		id: string
		status: string
		scooterId: string
		startTime: string
	}

	const activeBooking = ref<ActiveBookingInfo | null>(null)
	const elapsedText = ref('')
	let elapsedTimer: number | null = null

	const readStorageString = (key: string): string => {
		const raw = uni.getStorageSync(key)
		return raw == null ? '' : ('' + raw).trim()
	}

	const readStorageStringOrNull = (key: string): string | null => {
		const value = readStorageString(key)
		return value.length < 1 ? null : value
	}

	const formatElapsed = (startTimeStr: string): string => {
		const startMs = Date.parse(startTimeStr)
		if (isNaN(startMs)) return ''
		const nowMs = Date.now()
		const diffMin = Math.floor((nowMs - startMs) / 60000)
		if (diffMin < 0) return ''
		if (diffMin < 60) return diffMin + 'm'
		const h = Math.floor(diffMin / 60)
		const m = diffMin % 60
		const mStr = m < 10 ? ('0' + m) : '' + m
		return h + 'h ' + mStr + 'm'
	}

	const clearElapsedTimer = () => {
		const id = elapsedTimer
		if (id != null) {
			clearInterval(id)
			elapsedTimer = null
		}
	}

	const startElapsedTimer = () => {
		clearElapsedTimer()
		const update = () => {
			const booking = activeBooking.value
			if (booking == null || booking.status != 'CONFIRMED') return
			elapsedText.value = formatElapsed(booking.startTime)
		}
		update()
		elapsedTimer = setInterval(update, 60000)
	}

	const checkActiveBooking = () => {
		const userId = readStorageStringOrNull('userId')
		const token = readStorageStringOrNull('token')
		if (userId == null || token == null) {
			activeBooking.value = null
			clearElapsedTimer()
			return
		}
		uni.request({
			url: BASE_URL + '/api/v1/users/' + userId + '/bookings?page=1&size=10',
			method: 'GET',
			header: {
				'Content-Type': 'application/json',
				'Authorization': 'Bearer ' + token
			},
			success: (res) => {
				if (res.statusCode < 200 || res.statusCode >= 300) {
					activeBooking.value = null
					clearElapsedTimer()
					return
				}
				const responseData = res.data
				if (responseData == null || typeof responseData != 'object') {
					activeBooking.value = null
					clearElapsedTimer()
					return
				}
				const obj = responseData as UTSJSONObject
				let arr: any[] = []
				if (obj['data'] != null && Array.isArray(obj['data'])) {
					arr = obj['data'] as any[]
				}
				let found: ActiveBookingInfo | null = null
				for (let i = 0; i < arr.length; i++) {
					const item = arr[i] as UTSJSONObject
					const rawStatus = item['status']
					const status = rawStatus != null ? ('' + rawStatus).trim().toUpperCase() : ''
					if (status == 'CONFIRMED' || status == 'PENDING_PAYMENT') {
						const rawId = item['id']
						const id = rawId != null ? ('' + rawId) : ''
						const rawScooterId = item['scooter_id'] != null ? item['scooter_id'] : item['scooterId']
						const scooterId = rawScooterId != null ? ('' + rawScooterId) : ''
						const rawStart = item['start_time'] != null ? item['start_time'] : item['startTime']
						const startTime = rawStart != null ? ('' + rawStart) : ''
						found = { id: id, status: status, scooterId: scooterId, startTime: startTime }
						break
					}
				}
				activeBooking.value = found
				if (found != null && found.status == 'CONFIRMED') {
					startElapsedTimer()
				} else {
					clearElapsedTimer()
					elapsedText.value = ''
				}
			},
			fail: () => {
				activeBooking.value = null
				clearElapsedTimer()
			}
		})
	}

	const showVehicleIntro = () => {
		isVehicleIntroVisible.value = true
	}
	
	const hideVehicleIntro = () => {
		isVehicleIntroVisible.value = false
	}
	
	const toRadians = (deg: number): number => {
		return deg * Math.PI / 180
	}

	const distanceInMeters = (lat1: number, lng1: number, lat2: number, lng2: number): number => {
		const earthRadius = 6371000
		const dLat = toRadians(lat2 - lat1)
		const dLng = toRadians(lng2 - lng1)
		const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
			Math.cos(toRadians(lat1)) * Math.cos(toRadians(lat2)) *
			Math.sin(dLng / 2) * Math.sin(dLng / 2)
		const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))
		return earthRadius * c
	}
	
	const DEFAULT_SCOOTER_MARKER_ICON = '/static/markers/scooter-marker-gen1.png'

	const normalizeScooterType = (type: string | null): string => {
	  if (type == null || type.length == 0) return 'GEN1'
	  const value = ('' + type).trim().toUpperCase()
	  if (value == 'GEN3 PRO' || value == 'GEN3_PRO' || value == 'GEN-3-PRO') {
	    return 'GEN3PRO'
	  }
	  return value.length > 0 ? value : 'GEN1'
	}

	const getScooterMarkerIcon = (type: string | null): string => {
	  switch (normalizeScooterType(type)) {
	    case 'GEN2':
	      return '/static/markers/scooter-marker-gen2.png'
	    case 'GEN3':
	      return '/static/markers/scooter-marker-gen3.png'
	    case 'GEN3PRO':
	      return '/static/markers/scooter-marker-gen3pro.png'
	    case 'GEN1':
	      return '/static/markers/scooter-marker-gen1.png'
	    default:
	      return DEFAULT_SCOOTER_MARKER_ICON
	  }
	}

	const isAvailableScooterMarker = (item: UTSJSONObject): boolean => {
	  const rawStatus = item['status']
	  if (rawStatus == null) return true
	  return ('' + rawStatus).trim().toUpperCase() == 'AVAILABLE'
	}

	const fetchScooterMarkers = (lat: number, lng: number) => {
	  uni.request({
	    url: BASE_URL + '/api/v1/scooters?status=AVAILABLE&_t=' + Date.now(),
	    method: 'GET',
	    success: (res) => {
	      if (res.statusCode != 200 || res.data == null) {
	        markers.value = []
	        return
	      }
	      const raw = res.data as UTSJSONObject
	      let arr: UTSJSONObject[] = []
	      if (raw['data'] != null) {
	        arr = raw['data'] as UTSJSONObject[]
	      } else if (raw['scooters'] != null) {
	        arr = raw['scooters'] as UTSJSONObject[]
	      } else if (raw['list'] != null) {
	        arr = raw['list'] as UTSJSONObject[]
	      }
	      const scooterMarkers: Marker[] = []
	      let count = 0
	      for (let i = 0; i < arr.length && count < MARKER_LIMIT; i++) {
	        const item = arr[i] as UTSJSONObject
	        if (!isAvailableScooterMarker(item)) {
	          continue
	        }
	        const latVal = item['location_lat'] != null ? item['location_lat'] : item['locationLat']
	        const lngVal = item['location_lng'] != null ? item['location_lng'] : item['locationLng']
	        const numLat = latVal != null ? (latVal as number) : null
	        const numLng = lngVal != null ? (lngVal as number) : null
	        if (numLat != null && numLng != null && !isNaN(numLat) && !isNaN(numLng)) {
	          if (distanceInMeters(lat, lng, numLat, numLng) > FILTER_RADIUS_METERS) {
	            continue
	          }
	          const rawId = item['id']
	          const sid = rawId != null ? ('SC' + ('' + rawId)) : ('SC' + (count + 1))
	          const type = item['type'] != null ? ('' + item['type']) : null
	          scooterMarkers.push({
	            id: 10 + count,
	            latitude: numLat,
	            longitude: numLng,
	            title: sid,
	            iconPath: getScooterMarkerIcon(type),
	            width: 34,
	            height: 34,
	            anchor: { x: 0.5, y: 1 }
	          } as Marker)
	          count++
	        }
	      }
	      markers.value = scooterMarkers
	    },
	    fail: () => {
	      markers.value = []
	    }
	  })
	}
	
	const applyMarkers = (lat: number, lng: number) => {
	  fetchScooterMarkers(lat, lng)
	}

	const refreshMarkersByViewportCenter = () => {
		if (mapContext.value == null) {
			applyMarkers(latitude.value, longitude.value)
			return
		}
		mapContext.value.getCenterLocation({
			success: (res) => {
				const centerLat = res.latitude
				const centerLng = res.longitude
				if (centerLat == null || centerLng == null) {
					applyMarkers(latitude.value, longitude.value)
					return
				}
				applyMarkers(centerLat, centerLng)
			},
			fail: () => {
				applyMarkers(latitude.value, longitude.value)
			}
		})
	}

	const onMapRegionChange = (e: any | null) => {
		const timerToClear = regionDebounceTimer
		if (timerToClear != null) {
			clearTimeout(timerToClear as number)
			regionDebounceTimer = null
		}
		regionDebounceTimer = setTimeout(() => {
			refreshMarkersByViewportCenter()
		}, 500) as number
	}
	
	const getCurrentLocation = () => {
	  uni.getLocation({
	    type: 'gcj02',
	    success: (res) => {
	      const { longitude: lng, latitude: lat } = res
	      longitude.value = lng
	      latitude.value = lat
	      applyMarkers(lat, lng)
	      try {
        mapContext.value?.moveToLocation({ latitude: lat, longitude: lng })
      } catch (e) {
        console.error('moveToLocation failed', e)
      }
	    },
	    fail: (err) => {
	      console.error('定位失败', err)
	      showInfo('定位失败，请开启权限')
	    }
	  })
	}
	
	onMounted(() => {
	  const instance = getCurrentInstance()
	  if (instance != null && instance.proxy != null) {
	    mapContext.value = uni.createMapContext('mainMap', instance.proxy!)
	  } else {
	    mapContext.value = uni.createMapContext('mainMap')
	  }
	  getCurrentLocation()
	})

	
	onShow(() => {
	  checkActiveBooking()
	  applyMarkers(latitude.value, longitude.value)
	  nextTick(() => {
	    const instance = getCurrentInstance()
	    if (instance != null && instance.proxy != null) {
	      mapContext.value = uni.createMapContext('mainMap', instance.proxy!)
	    } else {
	      mapContext.value = uni.createMapContext('mainMap')
	    }
	    getCurrentLocation()
	  })
	})

	onHide(() => {
	  clearElapsedTimer()
	})
	
	const goToOrders = () => {
		uni.navigateTo({ url: '/pages/orders/orders' })
	}

	const formatScooterId = (scooterId: string | null): string => {
		if (scooterId == null || scooterId.length == 0) return '-'
		if (scooterId.startsWith('SC')) return scooterId
		return 'SC' + scooterId.padStart(3, '0')
	}

	// 跳转到单车列表页面（未登录先提示并进入登录页）
	const goToBikeList = () => {
		const token = uni.getStorageSync('token')
		if (token == null || token == '' || typeof token != 'string') {
			showThenNavigate(getAppMessage('auth', 'loginRequired', 'Please login first'), '/pages/login/login', false, 800, 'navigateTo')
			return
		}
		uni.navigateTo({
			url: '/pages/escooters/escooters'
		})
	}
</script>

<style lang="scss">
/* 首页样式：沉浸式地图、悬浮卡片、现代化UI */
	.page-container {
		position: relative;
		flex: 1;
		background-color: $bg-page;
		overflow: hidden;
	}

	.full-map {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
	}

	.top-notice-pill {
		position: absolute;
		top: 16px;
		left: 5%;
		width: 90%;
		height: 44px;
		background-color: rgba(255, 255, 255, 0.9);
		border-radius: 22px;
		flex-direction: row;
		align-items: center;
		padding: 0 16px;
		box-sizing: border-box;
		z-index: 10;
		box-shadow: $shadow-card;
	}

	.notice-icon {
		width: 20px;
		height: 20px;
		margin-right: 12px;
	}

	.notice-swiper {
		flex: 1;
		height: 100%;
	}

	.notice-text {
		line-height: 44px;
		font-size: $font-hint;
		color: $text-primary;
		lines: 1;
		text-overflow: ellipsis;
	}

	.order-overview-pill {
		position: absolute;
		top: 16px;
		left: 5%;
		width: 90%;
		height: 56px;
		background-color: #ffffff;
		border-radius: 16px;
		flex-direction: row;
		align-items: center;
		padding: 0 16px;
		box-sizing: border-box;
		z-index: 10;
		box-shadow: $shadow-card;
	}

	.order-accent-bar {
		width: 4px;
		height: 28px;
		border-radius: 2px;
		margin-right: 14px;
	}

	.accent-confirmed {
		background-color: $brand-green;
	}

	.accent-awaiting {
		background-color: $status-awaiting;
	}

	.order-content {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.order-main-row {
		display: flex;
		flex-direction: column;
	}

	.order-status-label {
		font-size: $font-body;
		font-weight: bold;
		margin-bottom: 2px;
	}

	.label-confirmed {
		color: $brand-green;
	}

	.label-awaiting {
		color: $status-awaiting;
	}

	.order-detail-text {
		font-size: $font-caption;
		color: $text-secondary;
	}

	.order-chevron {
		font-size: $font-section;
		color: $text-placeholder;
		margin-left: 12px;
	}

	.bottom-action-card {
		position: absolute;
		bottom: 80px;
		left: 4%;
		width: 92%;
		background-color: $bg-card;
		border-radius: 22px;
		padding: 20px 20px 18px;
		box-sizing: border-box;
		z-index: 10;
		box-shadow: $shadow-overlay;
		display: flex;
		flex-direction: column;
	}

	.card-header {
		margin-bottom: 14px;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}

	.card-title {
		font-size: $font-body;
		font-weight: 600;
		color: $text-primary;
	}

	.link-text {
		font-size: $font-caption;
		color: $brand-green;
		font-weight: 600;
	}

	.modern-swiper {
		width: 100%;
		height: 160px;
		border-radius: 16px;
		overflow: hidden;
		margin-bottom: 24px;
		background-color: #F0F0F0;
	}

	.card-img {
		width: 100%;
		height: 100%;
	}

	.booking-button {
		width: 100%;
		height: 52px;
		background-color: $brand-green;
		border-radius: 14px;
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		box-sizing: border-box;
		box-shadow: 0 4px 16px rgba(76, 175, 80, 0.3);
	}

	.btn-text {
		font-size: $font-title-sm;
		font-weight: 700;
		color: #ffffff;
		letter-spacing: 0.5px;
	}

	.btn-arrow {
		font-size: $font-title;
		font-weight: 400;
		color: rgba(255, 255, 255, 0.7);
		margin-left: 8px;
	}

</style>
