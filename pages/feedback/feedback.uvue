<template>
	<!-- 反馈页：输入滑板车ID、问题描述和位置，提交用户反馈 -->
	<view class="container">
		<view class="scroll-wrap" :style="{ height: scrollWrapHeight + 'px' }">
			<scroll-view class="scroll-area" direction="vertical" scroll-y="true" show-scrollbar="true" enable-back-to-top="true" :style="{ height: scrollViewHeight + 'px' }">
				<view class="title-section">
					<text class="title-text">Submit Feedback</text>
					<text class="hint-text">Report an issue or suggest an improvement</text>
					<text class="a11y-hint-text">Fields marked as required must be completed before submission.</text>
				</view>

				<view class="form-section">
					<view class="form-row">
						<text class="label">Scooter ID</text>
						<text v-if="!scooterIdReadonly" class="field-help">Required. Example: 1 or SC001.</text>
						<text v-else class="field-help">Auto-filled from your booking.</text>
						<input
							class="input"
							v-model="scooterId"
							:disabled="scooterIdReadonly"
							placeholder="e.g. 1 or SC001"
							placeholder-class="input-placeholder"
						/>
					</view>
					<view class="form-row">
						<text class="label">Description</text>
						<text class="field-help">Required. Describe the issue clearly so support can help faster.</text>
						<textarea
							class="textarea"
							v-model="description"
							placeholder="Describe your feedback (required)"
							placeholder-class="input-placeholder"
							:maxlength="500"
						/>
						<text class="char-count">{{ description.length }}/500</text>
					</view>
					<view class="form-row">
						<text class="label">Location (optional)</text>
						<input
							class="input"
							v-model="location"
							placeholder="e.g. Street name or area"
							placeholder-class="input-placeholder"
						/>
					</view>
					<view class="form-row">
						<text class="label">Priority</text>
						<text class="field-help">Choose HIGH only for urgent safety or service-impacting issues.</text>
						<view class="priority-options">
							<view :class="['priority-btn', 'priority-btn-margin', priority === 'LOW' ? 'priority-btn-active-low' : '']" @click="priority = 'LOW'">
								<text :class="['priority-text', priority === 'LOW' ? 'priority-text-active' : '']">LOW (General)</text>
							</view>
							<view :class="['priority-btn', priority === 'HIGH' ? 'priority-btn-active-high' : '']" @click="priority = 'HIGH'">
								<text :class="['priority-text', priority === 'HIGH' ? 'priority-text-active' : '']">HIGH (Urgent)</text>
							</view>
						</view>
					</view>

					<view class="form-row">
						<text class="label">Image (optional)</text>
						<view v-if="selectedFilePath.length > 0" class="image-preview">
							<image :src="selectedFilePath" mode="aspectFit" class="preview-img"></image>
							<view class="image-info">
								<text class="file-name">{{ selectedFileName }}</text>
								<text class="change-link" @click="chooseImageFile">Change</text>
							</view>
						</view>
						<view v-else class="upload-area" @click="chooseImageFile">
							<text class="upload-icon">+</text>
							<text class="upload-text">Tap to upload image</text>
						</view>
					</view>

					<view v-if="priority === 'HIGH'" class="warning-row">
						<text class="warning-text">High priority reports are escalated and should include clear details.</text>
					</view>

					<view v-if="submitError.length > 0" class="error-row">
						<text class="error-text">{{ submitError }}</text>
					</view>

					<button :class="['submit-btn', isSubmitting ? 'submit-btn-disabled' : '']" :disabled="isSubmitting" @click="onSubmit">Submit Feedback</button>
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script setup lang="uts">
// 反馈提交逻辑：表单校验、调用反馈接口提交数据、成功后重置表单
import { ref, onMounted } from 'vue'
import { onShow, onLoad } from '@dcloudio/uni-app'
import { BASE_URL } from '../../common/api.uts'
import { getAppMessage, getResponseMessage } from '../../common/messages.uts'
import { showSuccess, showError, showInfo } from '../../common/appToast.uts'

const scooterId = ref('')
const description = ref('')
const location = ref('')
const priority = ref('LOW')
const isSubmitting = ref(false)
const submitError = ref('')
const selectedFilePath = ref('')
const selectedFileName = ref('')
const bookingId = ref('')
const scooterIdReadonly = ref(false)
const scrollWrapHeight = ref(600)
const scrollViewHeight = ref(560)

const setScrollHeight = () => {
	try {
		const sys = uni.getSystemInfoSync()
		const h = sys.windowHeight != null ? sys.windowHeight : 600
		scrollWrapHeight.value = h
		scrollViewHeight.value = h - 24
	} catch (e) {
		scrollWrapHeight.value = 600
		scrollViewHeight.value = 560
	}
}

const chooseImageFile = () => {
	uni.chooseImage({
		count: 1,
		sourceType: ['album', 'camera'],
		success: (res) => {
			if (res.tempFilePaths.length > 0) {
				selectedFilePath.value = res.tempFilePaths[0]
				const path = selectedFilePath.value
				const slashIndex = path.lastIndexOf('/')
				selectedFileName.value = slashIndex >= 0 ? path.substring(slashIndex + 1) : path
			}
		}
	})
}

const resetForm = () => {
	scooterId.value = ''
	description.value = ''
	location.value = ''
	priority.value = 'LOW'
	selectedFilePath.value = ''
	selectedFileName.value = ''
	bookingId.value = ''
	scooterIdReadonly.value = false
}

const uploadFeedbackImage = (feedbackId: number, token: string, successMsg: string, failMsg: string, networkMsg: string) => {
	uni.uploadFile({
		url: BASE_URL + '/api/v1/feedbacks/' + feedbackId + '/image',
		filePath: selectedFilePath.value,
		name: 'file',
		header: {
			'Authorization': 'Bearer ' + token
		},
		success: (uploadRes) => {
			if (uploadRes.statusCode >= 200 && uploadRes.statusCode < 300) {
				showSuccess(successMsg)
				resetForm()
			} else {
				showError(failMsg, 3000)
			}
		},
		fail: () => {
			showError(networkMsg)
		},
		complete: () => {
			isSubmitting.value = false
		}
	})
}

const onSubmit = () => {
	submitError.value = ''
	const sid = scooterId.value.trim()
	const desc = description.value.trim()
	const loc = location.value.trim()
	const enterScooterIdMessage = getAppMessage('feedback', 'enterScooterId', 'Please enter Scooter ID')
	const enterDescriptionMessage = getAppMessage('feedback', 'enterDescription', 'Please enter a description')
	const submitSuccessMessage = getAppMessage('feedback', 'submitSuccess', 'Feedback submitted')
	const submitFailedMessage = getAppMessage('feedback', 'submitFailed', 'Failed to submit feedback')
	const requestFailedMessage = getAppMessage('network', 'requestFailed', 'Network error, please try again')

	if (sid.length < 1) {
		submitError.value = enterScooterIdMessage
		showInfo(enterScooterIdMessage)
		return
	}
	if (desc.length < 1) {
		submitError.value = enterDescriptionMessage
		showInfo(enterDescriptionMessage)
		return
	}

	isSubmitting.value = true

	const tokenRaw = uni.getStorageSync('token')
	const token = tokenRaw != null ? ('' + tokenRaw).trim() : ''
	const header: UTSJSONObject = {
		'Content-Type': 'application/json'
	}
	if (token.length > 0) {
		header['Authorization'] = 'Bearer ' + token
	}

	const body: UTSJSONObject = {
		'scooter_id': sid,
		'description': desc,
		'priority': priority.value
	}
	if (loc.length > 0) {
		body['location'] = loc
	}
	if (bookingId.value.length > 0) {
		body['booking_id'] = parseInt(bookingId.value)
	}

	uni.request({
		url: BASE_URL + '/api/v1/feedbacks',
		method: 'POST',
		header: header,
		data: body,
		success: (res) => {
			if (res.statusCode >= 200 && res.statusCode < 300) {
				const hasImage = selectedFilePath.value.length > 0
				if (hasImage) {
					const responseData = res.data as UTSJSONObject
					const dataObj = responseData['data'] as UTSJSONObject
					const feedbackId = dataObj['id'] as number
					uploadFeedbackImage(feedbackId, token, submitSuccessMessage, submitFailedMessage, requestFailedMessage)
				} else {
					showSuccess(submitSuccessMessage)
					resetForm()
					isSubmitting.value = false
				}
			} else {
				const msg = getResponseMessage(res.data, submitFailedMessage)
				submitError.value = msg
				showError(msg, 3000)
				isSubmitting.value = false
			}
		},
		fail: () => {
			submitError.value = requestFailedMessage
			showError(requestFailedMessage)
			isSubmitting.value = false
		}
	})
}

onLoad((options) => {
    const params = options as UTSJSONObject | null
    if (params == null) return
    const queryScooterId = params['scooter_id']
    if (queryScooterId != null) {
        const value = ('' + queryScooterId).trim()
        if (value.length > 0) {
            scooterId.value = value
            scooterIdReadonly.value = true
        }
    }
    const queryBookingId = params['booking_id']
    if (queryBookingId != null) {
        const value = ('' + queryBookingId).trim()
        if (value.length > 0) {
            bookingId.value = value
        }
    }
})

onMounted(() => {
	setScrollHeight()
})

onShow(() => {
	setScrollHeight()
})
</script>

<style lang="scss">
/* 反馈页样式：表单卡片、输入框、字数计数、错误提示、提交按钮 */
.container {
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	background-color: $bg-page;
}

.scroll-wrap {
	width: 100%;
}

.scroll-area {
	width: 100%;
	padding: 0 $page-padding-h $page-padding-bottom;
	box-sizing: border-box;
}

.title-section {
	display: flex;
	flex-direction: column;
	margin-bottom: 24px;
}

.title-text {
	font-size: $font-title;
	font-weight: $fw-bold;
	color: $text-primary;
	margin-bottom: 8px;
}

.hint-text {
	font-size: $font-body;
	color: $text-secondary;
	margin-bottom: 6px;
}

.a11y-hint-text {
	font-size: $font-caption;
	color: $text-primary;
}

.form-section {
	display: flex;
	flex-direction: column;
	background-color: white;
	border-radius: 12px;
	padding: 20px;
	box-shadow: $shadow-card;
}

.form-row {
	display: flex;
	flex-direction: column;
	margin-bottom: 16px;
}

.label {
	font-size: $font-body;
	font-weight: $fw-bold;
	color: $text-primary;
	margin-bottom: 8px;
}

.field-help {
	font-size: $font-hint;
	color: $text-secondary;
	margin-bottom: 8px;
}

.input {
	height: 44px;
	padding: 0 12px;
	border: 1px solid $border-input;
	border-radius: 8px;
	font-size: $font-body;
	background-color: $bg-card;
	color: $text-primary;
}

.textarea {
	min-height: 100px;
	padding: 12px;
	border-width: 1px;
	border-style: solid;
	border-color: $border-base;
	border-radius: 8px;
	font-size: $font-body;
	background-color: white;
}

.input-placeholder {
	color: $text-placeholder;
}

.char-count {
	font-size: $font-hint;
	color: $text-placeholder;
	margin-top: 4px;
}

.error-row {
	margin-bottom: 12px;
	padding: 10px 12px;
	background-color: #fef2f2;
	border-radius: 8px;
	border-width: 1px;
	border-style: solid;
	border-color: #dc2626;
}

.error-text {
	font-size: $font-body;
	color: #b91c1c;
	font-weight: $fw-bold;
}

.warning-row {
	margin-bottom: 12px;
	padding: 10px 12px;
	background-color: #fff7ed;
	border-radius: 8px;
	border-width: 1px;
	border-style: solid;
	border-color: #c2410c;
}

.warning-text {
	font-size: $font-caption;
	color: #9a3412;
}

.submit-btn {
	margin-top: 8px;
	height: 44px;
	padding: 14px;
	background-color: $brand-green;
	color: white;
	border-width: 0;
	border-radius: 8px;
	font-size: $font-section;
	font-weight: $fw-bold;
}

.submit-btn-disabled {
	background-color: $bg-disabled;
}

.priority-options {
	display: flex;
	flex-direction: row;
}

.priority-btn {
	flex: 1;
	height: 44px;
	border-width: 1px;
	border-style: solid;
	border-color: $border-base;
	border-radius: 8px;
	display: flex;
	justify-content: center;
	align-items: center;
	background-color: white;
}

.priority-btn-margin {
	margin-right: 12px;
}

.priority-btn-active-low {
	background-color: $brand-green;
	border-color: $brand-green;
}

.priority-btn-active-high {
	background-color: $color-danger;
	border-color: $color-danger;
}

.priority-text {
	font-size: $font-body;
	color: $text-primary;
}

.priority-text-active {
	color: white;
	font-weight: $fw-bold;
}

.upload-area {
	border: 2px dashed $border-base;
	border-radius: 12px;
	padding: 24px;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	background-color: #fafafa;
}

.upload-icon {
	font-size: 32px;
	color: $text-placeholder;
	margin-bottom: 6px;
}

.upload-text {
	font-size: $font-caption;
	color: $text-placeholder;
}

.image-preview {
	border-radius: 10px;
	overflow: hidden;
	border: 1px solid $border-base;
}

.preview-img {
	width: 100%;
	height: 200px;
}

.image-info {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 8px 12px;
	background-color: #fafafa;
}

.file-name {
	font-size: $font-caption;
	color: $text-secondary;
	flex: 1;
}

.change-link {
	font-size: $font-caption;
	color: $brand-green;
	font-weight: $fw-bold;
}
</style>
