		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.5);
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.vehicle-intro-card {
		width: 86%;
		height: 68%;
		background-color: #f6f7fb;
		border-radius: 24px;
		padding: 18px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		box-shadow: $shadow-elevated;
	}

	.intro-header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 16px;
	}

	.intro-title {
		font-size: $font-title-sm;
		font-weight: $fw-bold;
		color: $text-primary;
	}

	.close-btn {
		font-size: $font-title-sm;
		color: $text-placeholder;
		padding: 4px;
	}

	.intro-scroll {
		flex: 1;
		width: 100%;
	}

	.intro-item {
		display: flex;
		flex-direction: column;
		margin-bottom: 12px;
		background-color: $bg-card;
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid $border-light;
		box-shadow: $shadow-card;
	}

	.intro-img-row {
		display: flex;
		flex-direction: row;
	}

	.intro-img {
		flex: 1;
		height: 118px;
	}

	.intro-img-spaced {
		margin-left: 2px;
	}

	.intro-text-box {
		padding: 10px 12px 12px;
	}

	.intro-name {
		font-size: $font-micro;
		font-weight: $fw-bold;
		color: $text-secondary;
		letter-spacing: 0.8px;
		margin-bottom: 2px;
	}

	.intro-subtitle {
		font-size: $font-section;
		font-weight: $fw-bold;
		color: $text-primary;
		margin-bottom: 8px;
	}

	.intro-meta-row {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		margin-bottom: 8px;
	}

	.meta-chip {
		flex: 1;
		background-color: #f8fafc;
		border: 1px solid $border-light;
		border-radius: 10px;
		padding: 7px 6px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.meta-chip-spaced {
		margin-left: 10px;
	}

	.meta-label {
		font-size: $font-micro;
		font-weight: $fw-bold;
		color: $text-secondary;
		margin-bottom: 3px;
	}

	.meta-value {
		font-size: $font-micro;
		font-weight: $fw-bold;
		color: $text-primary;
	}

	.intro-advice {
		padding: 7px 9px;
		background: #f8fafc;
		border-radius: 8px;
	}

	.intro-advice-text {
		font-size: $font-micro;
		color: $text-primary;
		line-height: 1.3;
	}
</style>
